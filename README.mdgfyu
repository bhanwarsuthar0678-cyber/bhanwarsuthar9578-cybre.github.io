        }

        footer {
            background-color: #08080A;
            text-align: center;
            padding: 40px 20px;
            border-top: 1px solid #222;
            font-size: 0.85rem;
            letter-spacing: 1px;
            color: #666;
        }
    </style>
</head>
<body>

    <header>
        <h1>Suthar's Empires</h1>
        <p>Crafting Imperial Legacies In Wood</p>
    </header>

    <section class="hero">
        <h2>Where Royalty Meets Craftsmanship</h2>
        <p>Every piece is a unique architectural masterpiece created from rare structural woods, layered with pure precious metals, designed to outlast generations.</p>
        <button class="cta-btn" onclick="requestImperialConsultation()">Request Commission</button>
    </section>

    <main class="catalog">
        <h3>The Emperor Selection</h3>
        <div class="grid">
            {% for product in products %}
            <div class="product-card">
                <div>
                    <div class="product-title">{{ product.name }}</div>
                    <div class="meta">{{ product.collection }} | {{ product.wood }}</div>
                    <div class="desc">{{ product.desc }}</div>
                </div>
                <div>
                    <div class="price">{{ product.price }}</div>
                    <button class="cta-btn" style="width: 100%; padding: 10px;" onclick="placeOrder('{{ product.name }}')">Acquire Piece</button>
                </div>
            </div>
            {% endfor %}
        </div>
    </main>

    <footer>
        &copy; 2026 Suthar's Empires. All Rights Reserved. Reserved for Royal Clientele.
