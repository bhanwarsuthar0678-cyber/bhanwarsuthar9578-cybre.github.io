# Frontend HTML/CSS Integration
HTML_TEMPLATE = """
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Suthar's Empires | Luxury Handcrafted Furniture</title>
    <style>
        :root {
            --gold: #D4AF37;
            --dark-gold: #AA7C11;
            --royal-black: #0F0F11;
            --luxury-cream: #F9F6F0;
            --charcoal: #1A1A1E;
        }
        
        body {
            font-family: 'Cinzel', 'Didot', 'Georgia', serif;
            background-color: var(--royal-black);
            color: var(--luxury-cream);
            margin: 0;
            padding: 0;
        }

        header {
            border-bottom: 1px solid var(--gold);
            padding: 30px 5%;
            text-align: center;
            background-color: rgba(15, 15, 17, 0.95);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        header h1 {
            margin: 0;
            font-size: 2.8rem;
            letter-spacing: 6px;
            color: var(--gold);
            text-transform: uppercase;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.6);
        }

        header p {
            margin: 5px 0 0;
            font-size: 0.9rem;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: #bfa15f;
        }

        .hero {
            text-align: center;
            padding: 100px 20px;
            background: linear-gradient(rgba(15,15,17,0.7), rgba(15,15,17,0.9)), url('https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=1600&q=80') no-repeat center center/cover;
        }

        .hero h2 {
            font-size: 3.5rem;
            margin-bottom: 20px;
            color: var(--luxury-cream);
        }

        .hero p {
            font-size: 1.2rem;
            max-width: 700px;
            margin: 0 auto 40px;
            line-height: 1.8;
            color: #ccc;
        }

        .cta-btn {
            background-color: transparent;
            color: var(--gold);
            border: 2px solid var(--gold);
            padding: 15px 40px;
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            cursor: pointer;
            transition: all 0.4s ease;
        }

        .cta-btn:hover {
            background-color: var(--gold);
            color: var(--royal-black);
            box-shadow: 0 0 15px var(--gold);
        }

        .catalog {
            max-width: 1200px;
            margin: 80px auto;
            padding: 0 20px;
        }

        .catalog h3 {
            text-align: center;
            font-size: 2.2rem;
            color: var(--gold);
            margin-bottom: 50px;
            text-transform: uppercase;
            letter-spacing: 3px;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
            gap: 40px;
        }

        .product-card {
            background-color: var(--charcoal);
            border: 1px solid #2A2A30;
            border-radius: 4px;
            padding: 30px;
            transition: transform 0.3s ease, border-color 0.3s ease;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .product-card:hover {
            transform: translateY(-10px);
            border-color: var(--gold);
        }

        .product-title {
            font-size: 1.5rem;
            color: var(--luxury-cream);
            margin-top: 0;
            margin-bottom: 10px;
        }

        .meta {
            font-size: 0.85rem;
            color: var(--gold);
            text-transform: uppercase;
            margin-bottom: 15px;
            letter-spacing: 1px;
        }

        .desc {
            color: #aaa;
            font-size: 0.95rem;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .price {
            font-size: 1.6rem;
            font-weight: bold;
            color: var(--gold);
