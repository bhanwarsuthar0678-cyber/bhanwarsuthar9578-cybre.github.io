# ------------------------------------------------------------------------------
# SECTION 1: DATABASE ARCHITECTURE (SQL)
# ------------------------------------------------------------------------------
'''
Execute this SQL script in your database system (PostgreSQL / MySQL) to initialize 
the relational structure for Suthar's Empires.
'''

SQL_SCHEMA = """
CREATE DATABASE suthars_empires_db;
\\c suthars_empires_db;

-- 1. Users & Royal Clientele Table
CREATE TABLE users (
    user_id SERIAL PRIMARY KEY,
    full_name VARCHAR(100) NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    membership_tier VARCHAR(20) DEFAULT 'Royal' CHECK (membership_tier IN ('Royal', 'Imperial', 'Emperor')),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 2. Luxury Furniture Catalog Table
CREATE TABLE products (
    product_id SERIAL PRIMARY KEY,
    sku VARCHAR(50) UNIQUE NOT NULL,
    name VARCHAR(150) NOT NULL,
    collection VARCHAR(100) DEFAULT 'Imperial Collection',
    wood_type VARCHAR(100) DEFAULT 'Premium Teakwood / Royal Mahogany',
    description TEXT,
    price DECIMAL(12, 2) NOT NULL,
    stock_quantity INT DEFAULT 5,
    image_url VARCHAR(255)
);

-- 3. Elite Custom Orders Table
CREATE TABLE orders (
    order_id SERIAL PRIMARY KEY,
    user_id INT REFERENCES users(user_id) ON DELETE CASCADE,
    order_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    total_amount DECIMAL(15, 2) NOT NULL,
    order_status VARCHAR(30) DEFAULT 'Crafting In Progress' CHECK (order_status IN ('Designing', 'Crafting In Progress', 'Polishing', 'Dispatched', 'Delivered'))
);

-- Seed Premium Luxury Inventory
INSERT INTO products (sku, name, collection, wood_type, description, price, stock_quantity) VALUES
('SE-ROYAL-SOFA-01', 'The Emperor Chesterfield 12-Seater', 'Maharaja Dynasty', 'Premium Burma Teak & Gold Leaf Inlay', 'Handcrafted royal sofa upholstered in velvet with pure gold leaf detailing.', 1250000.00, 2),
('SE-BED-02', 'Imperial Canopy Bed', 'Victorian Mansion', 'Solid African Mahogany & Silk Canopy', 'A masterfully carved canopy bed fit for modern emperors.', 1850000.00, 3),
('SE-DINING-03', 'Grand Banqueting Table (16-Chair)', 'Royal Banquet', 'Walnut Burl & Mother of Pearl Inlays', 'Magnificent long dining table with matching custom-carved luxury chairs.', 2400000.00, 1);
"""

# ------------------------------------------------------------------------------
# SECTION 2: BACKEND ENGINE (PYTHON - FLASK FRAMEWORK)
# ------------------------------------------------------------------------------
import json
from flask import Flask, render_template_string, jsonify, request

app = Flask(__name__)

# Mock Database Connection for Seamless Execution
