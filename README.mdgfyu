    <script>
        function requestImperialConsultation() {
            alert("An Imperial Design Consultant from Suthar's Empires will contact your estate within 24 hours.");
        }

        function placeOrder(productName) {
            alert("A secure procurement pipeline has been initiated for: " + productName + ". Our dispatch division will coordinate with your security team.");
        }
    </script>
</body>
</html>
"""

@app.route('/')
def home():
    return render_template_string(HTML_TEMPLATE, products=LUXURY_PRODUCTS)

@app.route('/api/catalog', methods=['GET'])
def get_catalog():
    return jsonify({"status": "Success", "data": LUXURY_PRODUCTS})

if __name__ == '__main__':
    print("Suthar's Empires Luxury Platform Initialized on http://127.0.0.1:5000")
